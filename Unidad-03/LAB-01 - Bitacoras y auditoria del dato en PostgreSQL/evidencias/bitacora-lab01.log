	   OR linea ILIKE '%sentencia: DELETE FROM clientes%'

	   OR linea ILIKE '%sentencia: DROP ROLE soporte_ana%'

	   OR linea ILIKE '%privilegios para tabla clientes%'

	ORDER BY num;

